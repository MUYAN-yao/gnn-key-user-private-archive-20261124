\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Exact best-score tie proportions for all 14 full-greedy trajectories, arranged in seven panels by network and seed budget. Filled circles and solid lines identify path 301; open squares and dashed lines identify path 302. Each value divides the number of tied rounds by that panel's seed budget, five or 20. Lines connect nested-budget results from re-optimized searches, not necessarily identical intermediate seed sets; no interpolation or monotonicity is assumed. Coincident markers are retained. All 42 block-budget observations are supplied in \path {FigS1-tie-trajectories-source.csv}. No uncertainty intervals or statistical tests are applied to these descriptive trajectories.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:4}{{4}{12}{Exact best-score tie proportions for all 14 full-greedy trajectories, arranged in seven panels by network and seed budget. Filled circles and solid lines identify path 301; open squares and dashed lines identify path 302. Each value divides the number of tied rounds by that panel's seed budget, five or 20. Lines connect nested-budget results from re-optimized searches, not necessarily identical intermediate seed sets; no interpolation or monotonicity is assumed. Coincident markers are retained. All 42 block-budget observations are supplied in \protect \path {FigS1-tie-trajectories-source.csv}. No uncertainty intervals or statistical tests are applied to these descriptive trajectories}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Do changed traces also change final sets?}{12}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Complete same-budget ordered-agreement matrix. Rows identify all 14 network--seed-budget--path blocks; columns give selection-world budgets within each candidate-pool panel. An equals sign indicates an identical ordered trace with a genuinely restricted pool, a cross indicates a different trace, and V identifies a pool containing every graph node. All V cells match by full-pool consistency; they are not successful truncations. All 126 pool-condition comparisons are shown. These are descriptive computational comparisons with shared worlds, not independent population replicates.}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:5}{{5}{13}{Complete same-budget ordered-agreement matrix. Rows identify all 14 network--seed-budget--path blocks; columns give selection-world budgets within each candidate-pool panel. An equals sign indicates an identical ordered trace with a genuinely restricted pool, a cross indicates a different trace, and V identifies a pool containing every graph node. All V cells match by full-pool consistency; they are not successful truncations. All 126 pool-condition comparisons are shown. These are descriptive computational comparisons with shared worlds, not independent population replicates}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Condition-level computation--utility trade-off at three selection resolutions. Each panel shows 14 conditions per candidate pool, for 126 observations overall; overlapping points are retained. The horizontal axis gives measured time saving relative to the full arm, including search and final evaluation but excluding graph preparation and degree ranking. The vertical axis gives candidate-minus-full mean activated-node counts on 2,000 disjoint evaluation worlds; the dashed line denotes zero difference. Marker shape and color identify the pools. Values are finite-sample point estimates without inferential intervals. Shared evaluation worlds and repeated network instances make observations dependent.}}{13}{figure.6}\protected@file@percent }
\newlabel{fig:6}{{6}{13}{Condition-level computation--utility trade-off at three selection resolutions. Each panel shows 14 conditions per candidate pool, for 126 observations overall; overlapping points are retained. The horizontal axis gives measured time saving relative to the full arm, including search and final evaluation but excluding graph preparation and degree ranking. The vertical axis gives candidate-minus-full mean activated-node counts on 2,000 disjoint evaluation worlds; the dashed line denotes zero difference. Marker shape and color identify the pools. Values are finite-sample point estimates without inferential intervals. Shared evaluation worlds and repeated network instances make observations dependent}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Post-hoc seed-set diagnostics from frozen full-greedy outputs. (a) Final-set Jaccard similarity for both adjacent budget transitions within each of the 14 blocks. Grey segments connect the two transitions of the same block; overlapping symbols are retained. (b) The first differing greedy round divided by the seed budget. Smaller values indicate earlier divergence, not a larger utility penalty. Path identifiers 301 and 302 denote the two random-world realizations. These diagnostics were added after confirmation and are not new independent replications.}}{14}{figure.7}\protected@file@percent }
\newlabel{fig:7}{{7}{14}{Post-hoc seed-set diagnostics from frozen full-greedy outputs. (a) Final-set Jaccard similarity for both adjacent budget transitions within each of the 14 blocks. Grey segments connect the two transitions of the same block; overlapping symbols are retained. (b) The first differing greedy round divided by the seed budget. Smaller values indicate earlier divergence, not a larger utility penalty. Path identifiers 301 and 302 denote the two random-world realizations. These diagnostics were added after confirmation and are not new independent replications}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Post-hoc conditional evaluation uncertainty at 320 selection worlds. Points show candidate-minus-full spread on 2,000 shared, disjoint evaluation worlds; horizontal segments show paired normal-approximation 95\% Monte Carlo intervals. The vertical dashed line marks zero. Identical sets have zero paired differences in every world and therefore zero-width intervals. Such points include full-pool controls but are not limited to them. Intervals quantify evaluation sampling uncertainty conditional on the selected sets and fixed simulator; they do not quantify uncertainty across networks or establish practical equivalence.}}{15}{figure.8}\protected@file@percent }
\newlabel{fig:8}{{8}{15}{Post-hoc conditional evaluation uncertainty at 320 selection worlds. Points show candidate-minus-full spread on 2,000 shared, disjoint evaluation worlds; horizontal segments show paired normal-approximation 95\% Monte Carlo intervals. The vertical dashed line marks zero. Identical sets have zero paired differences in every world and therefore zero-width intervals. Such points include full-pool controls but are not limited to them. Intervals quantify evaluation sampling uncertainty conditional on the selected sets and fixed simulator; they do not quantify uncertainty across networks or establish practical equivalence}{figure.8}{}}
