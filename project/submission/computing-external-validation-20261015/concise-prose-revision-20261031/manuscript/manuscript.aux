\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Selection budget and ranking precision have distinct effects on candidate-restriction quality. At each $W$, restricted methods are compared with the full reference selected at that same $W$; evaluation uses fixed independent worlds. Points are mean incremental losses over five paired paths; bars are path standard deviations. The plotted labels Default and Strict denote tolerances $10^{-6}$ and $10^{-12}$; candidate membership is unchanged between $10^{-12}$ and $10^{-14}$. Negative loss favors the restricted set. The ca-GrQc default reversal disappears with the tighter PageRank tolerance, while the directed-network losses persist. This is a post-hoc paired sensitivity analysis.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:precision-budget}{{2}{10}{Selection budget and ranking precision have distinct effects on candidate-restriction quality. At each $W$, restricted methods are compared with the full reference selected at that same $W$; evaluation uses fixed independent worlds. Points are mean incremental losses over five paired paths; bars are path standard deviations. The plotted labels Default and Strict denote tolerances $10^{-6}$ and $10^{-12}$; candidate membership is unchanged between $10^{-12}$ and $10^{-14}$. Negative loss favors the restricted set. The ca-GrQc default reversal disappears with the tighter PageRank tolerance, while the directed-network losses persist. This is a post-hoc paired sensitivity analysis}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Ranking agreement depends on coverage and network context}{10}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Reference-set changes and independent spread changes, defined as higher-budget minus lower-budget full-reference spread. Filled circles denote changed final sets; hollow squares denote unchanged sets. Paths 1101--1105 run from left to right within each graph. Bars are unadjusted 95\% conditional Monte Carlo intervals from 10,000 paired worlds. Panel-specific vertical scales reveal small changes; the intervals condition on selected sets and do not describe variation across networks.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:transitions}{{3}{11}{Reference-set changes and independent spread changes, defined as higher-budget minus lower-budget full-reference spread. Filled circles denote changed final sets; hollow squares denote unchanged sets. Paths 1101--1105 run from left to right within each graph. Bars are unadjusted 95\% conditional Monte Carlo intervals from 10,000 paired worlds. Panel-specific vertical scales reveal small changes; the intervals condition on selected sets and do not describe variation across networks}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces External results at $W=1280$ (five paths). Degree-4k and PageRank-4k (PR) use 20-node pools; PR uses default tolerance. Full incremental spread is total spread minus $k=5$. PR gap is restricted minus full mean spread; loss is relative to full incremental spread. Degree agreement counts identical ordered trajectories.}}{12}{table.3}\protected@file@percent }
\newlabel{tab:primary}{{3}{12}{External results at $W=1280$ (five paths). Degree-4k and PageRank-4k (PR) use 20-node pools; PR uses default tolerance. Full incremental spread is total spread minus $k=5$. PR gap is restricted minus full mean spread; loss is relative to full incremental spread. Degree agreement counts identical ordered trajectories}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Reference-preserving savings under specified timing scopes}{12}{subsection.5.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Degree-4k cost at $W=1280$, averaged over five paths. Full and Degree columns give measured selection time. The final column estimates savings including setup, preparation of selection and evaluation worlds, selection and independent evaluation. These assembled warm-process costs exclude imports, JIT compilation, downloads and output writing; they are not direct end-to-end timings.}}{12}{table.4}\protected@file@percent }
\newlabel{tab:cost}{{4}{12}{Degree-4k cost at $W=1280$, averaged over five paths. Full and Degree columns give measured selection time. The final column estimates savings including setup, preparation of selection and evaluation worlds, selection and independent evaluation. These assembled warm-process costs exclude imports, JIT compilation, downloads and output writing; they are not direct end-to-end timings}{table.4}{}}
