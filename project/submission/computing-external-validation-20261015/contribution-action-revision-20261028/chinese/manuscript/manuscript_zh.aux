\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 预算与排名精度对候选限制质量产生不同影响。点为五条配对路径的平均增量传播损失，误差线为路径标准差。图中的 Default 和 Strict 分别表示容差 $10^{-6}$ 和 $10^{-12}$；候选成员在 $10^{-12}$ 与 $10^{-14}$ 间保持不变。负损失表示受限集合的评估结果更高。收紧 PageRank 容差后，ca-GrQc 的默认反转消失，而有向网络上的损失仍存在。这是事后配对敏感性分析。}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:precision-budget}{{2}{11}{预算与排名精度对候选限制质量产生不同影响。点为五条配对路径的平均增量传播损失，误差线为路径标准差。图中的 Default 和 Strict 分别表示容差 $10^{-6}$ 和 $10^{-12}$；候选成员在 $10^{-12}$ 与 $10^{-14}$ 间保持不变。负损失表示受限集合的评估结果更高。收紧 PageRank 容差后，ca-GrQc 的默认反转消失，而有向网络上的损失仍存在。这是事后配对敏感性分析。}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}排名一致性受覆盖率与网络背景限定}{11}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 参照集合变化与独立传播量变化。实心圆表示最终集合变化，空心方块表示集合未变。每个图内，路径 1101--1105 从左至右排列。误差线为根据 10,000 个配对世界计算的未经校正的 95\% 条件蒙特卡洛区间。各面板采用不同纵轴尺度，以显示较小的变化；区间以已选集合为条件，不描述网络间变异。}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:transitions}{{3}{12}{参照集合变化与独立传播量变化。实心圆表示最终集合变化，空心方块表示集合未变。每个图内，路径 1101--1105 从左至右排列。误差线为根据 10,000 个配对世界计算的未经校正的 95\% 条件蒙特卡洛区间。各面板采用不同纵轴尺度，以显示较小的变化；区间以已选集合为条件，不描述网络间变异。}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces 外部网络在 $W=1280$ 下的结果（五条路径）。Degree-4k 与 PageRank-4k（PR）使用 20 节点候选池；PR 使用默认容差。全候选参照增量传播量为总传播量减去 $k=5$。PR 差值为受限选择减全候选选择的平均传播量；损失以全候选参照的增量传播量为基准。一致性计数指完全相同的有序轨迹。}}{13}{table.3}\protected@file@percent }
\newlabel{tab:primary}{{3}{13}{外部网络在 $W=1280$ 下的结果（五条路径）。Degree-4k 与 PageRank-4k（PR）使用 20 节点候选池；PR 使用默认容差。全候选参照增量传播量为总传播量减去 $k=5$。PR 差值为受限选择减全候选选择的平均传播量；损失以全候选参照的增量传播量为基准。一致性计数指完全相同的有序轨迹。}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}指定计时范围下保持参照结果的计算节省}{13}{subsection.5.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Degree-4k 在 $W=1280$ 下的成本，取五条路径平均。Full 与 Degree 列为实测选择时间。最后一列估计包含准备阶段、选择及评估世界准备、种子选择和独立评估的成本节省。这些暖进程拼接成本排除导入、JIT 编译、下载和输出写入，并非直接端到端计时。}}{14}{table.4}\protected@file@percent }
\newlabel{tab:cost}{{4}{14}{Degree-4k 在 $W=1280$ 下的成本，取五条路径平均。Full 与 Degree 列为实测选择时间。最后一列估计包含准备阶段、选择及评估世界准备、种子选择和独立评估的成本节省。这些暖进程拼接成本排除导入、JIT 编译、下载和输出写入，并非直接端到端计时。}{table.4}{}}
