\newlabel{tab:transitions}{{4}{13}{Full-reference transitions under step coupling. Gain is the paired independent change in total spread; seed counts are constant. The range is across paths, not a confidence interval}{table.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Coupling and computational cost}{13}{subsection.5.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Full-reference paired spread changes for adjacent budgets. Each graph contributes paths 1101--1105 from left to right. Filled circles mark changed final sets; hollow squares mark unchanged sets. Bars are unadjusted 95\% normal conditional Monte Carlo intervals from 10,000 paired worlds. Panels use different vertical ranges to display the measured changes; these are not across-network confidence intervals}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:transitions}{{5}{14}{Full-reference paired spread changes for adjacent budgets. Each graph contributes paths 1101--1105 from left to right. Filled circles mark changed final sets; hollow squares mark unchanged sets. Bars are unadjusted 95\% normal conditional Monte Carlo intervals from 10,000 paired worlds. Panels use different vertical ranges to display the measured changes; these are not across-network confidence intervals}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Degree-4k cost at $W=1280$. Seconds are frozen selection measurements averaged over five paths. Verification savings use the separately measured setup plus frozen world, selection and evaluation times; they are hybrid estimates, not direct end-to-end trials.}}{14}{table.5}\protected@file@percent }
\newlabel{tab:cost}{{5}{14}{Degree-4k cost at $W=1280$. Seconds are frozen selection measurements averaged over five paths. Verification savings use the separately measured setup plus frozen world, selection and evaluation times; they are hybrid estimates, not direct end-to-end trials}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Descriptive loss--cost decisions for the frozen default-tolerance matrix at $W=1280$. Cells count paths whose point-estimate incremental loss is at or below the column tolerance. Row labels report mean hybrid verification-inclusive saving across all five paths, whether or not they pass. Random rows first average three pools within each path and use the mean cost of one random-pool deployment. The tolerances are illustrative, not justified application thresholds or noninferiority tests}}{16}{figure.6}\protected@file@percent }
\newlabel{fig:cost}{{6}{16}{Descriptive loss--cost decisions for the frozen default-tolerance matrix at $W=1280$. Cells count paths whose point-estimate incremental loss is at or below the column tolerance. Row labels report mean hybrid verification-inclusive saving across all five paths, whether or not they pass. Random rows first average three pools within each path and use the mean cost of one random-pool deployment. The tolerances are illustrative, not justified application thresholds or noninferiority tests}{figure.6}{}}
