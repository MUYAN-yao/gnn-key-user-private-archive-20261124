\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces ca-GrQc PageRank-4k的精度控制。每个预算使用原五条路径；差值为受限方法减同预算全候选参照，单位为节点。SD为路径间标准差；集合变化指固定预算下默认与严格容差之间的变化。}}{10}{table.3}\protected@file@percent }
\newlabel{tab:precision-output}{{3}{10}{ca-GrQc PageRank-4k的精度控制。每个预算使用原五条路径；差值为受限方法减同预算全候选参照，单位为节点。SD为路径间标准差；集合变化指固定预算下默认与严格容差之间的变化。}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}参照集合变化不能决定传播量变化}{10}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 选择预算与排名精度对候选限制质量产生不同影响。每个 $W$ 下，受限方法均与该预算下选出的全候选参照比较；独立评估世界保持固定。点为五条配对路径的平均增量传播损失，误差线为路径标准差。图中的 Default 和 Strict 分别表示容差 $10^{-6}$ 和 $10^{-12}$；候选成员在 $10^{-12}$ 与 $10^{-14}$ 间保持不变。负损失表示受限集合的评估结果更高。收紧 PageRank 容差后，ca-GrQc 的默认反转消失，而有向网络上的损失仍存在。这是事后配对敏感性分析。}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:precision-budget}{{2}{11}{选择预算与排名精度对候选限制质量产生不同影响。每个 $W$ 下，受限方法均与该预算下选出的全候选参照比较；独立评估世界保持固定。点为五条配对路径的平均增量传播损失，误差线为路径标准差。图中的 Default 和 Strict 分别表示容差 $10^{-6}$ 和 $10^{-12}$；候选成员在 $10^{-12}$ 与 $10^{-14}$ 间保持不变。负损失表示受限集合的评估结果更高。收紧 PageRank 容差后，ca-GrQc 的默认反转消失，而有向网络上的损失仍存在。这是事后配对敏感性分析。}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}排名一致性受覆盖率与网络背景限定}{11}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 参照集合变化与独立传播量变化，差值为高预算减低预算的全候选参照传播量。实心圆表示最终集合变化，空心方块表示集合未变。每个图内，路径 1101--1105 从左至右排列。误差线为根据 10,000 个配对世界计算的未经校正的 95\% 条件蒙特卡洛区间。各面板采用不同纵轴尺度，以显示较小的变化；区间以已选集合为条件，不描述网络间变异。}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:transitions}{{3}{12}{参照集合变化与独立传播量变化，差值为高预算减低预算的全候选参照传播量。实心圆表示最终集合变化，空心方块表示集合未变。每个图内，路径 1101--1105 从左至右排列。误差线为根据 10,000 个配对世界计算的未经校正的 95\% 条件蒙特卡洛区间。各面板采用不同纵轴尺度，以显示较小的变化；区间以已选集合为条件，不描述网络间变异。}{figure.3}{}}
