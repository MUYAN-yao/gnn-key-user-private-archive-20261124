\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces ca-GrQc上默认容差（$\tau =10^{-6}$）与严格容差（$\tau =10^{-12}$）的PageRank-4k结果。差值为受限方法减同预算全候选参照的传播量，单位为节点，报告五次重复的均值，括号内为重复间标准差。“集合改变”指两种容差选出不同最终集合的重复次数。}}{10}{table.3}\protected@file@percent }
\newlabel{tab:precision-output}{{3}{10}{ca-GrQc上默认容差（$\tau =10^{-6}$）与严格容差（$\tau =10^{-12}$）的PageRank-4k结果。差值为受限方法减同预算全候选参照的传播量，单位为节点，报告五次重复的均值，括号内为重复间标准差。“集合改变”指两种容差选出不同最终集合的重复次数。}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 与同预算全候选参照相比，两种PageRank候选池在默认（$\tau =10^{-6}$）及严格（$\tau =10^{-12}$）容差下的增量传播损失。上排为4k池，下排为5\%池。点为五次重复的均值，误差线为重复间标准差。正损失表示受限种子集合触达的节点较少。在ca-GrQc上，默认容差的4k池损失随预算改变符号，严格容差下均小于零。CollegeMsg和wiki-Vote在两种容差下均有损失。}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:precision-budget}{{2}{11}{与同预算全候选参照相比，两种PageRank候选池在默认（$\tau =10^{-6}$）及严格（$\tau =10^{-12}$）容差下的增量传播损失。上排为4k池，下排为5\%池。点为五次重复的均值，误差线为重复间标准差。正损失表示受限种子集合触达的节点较少。在ca-GrQc上，默认容差的4k池损失随预算改变符号，严格容差下均小于零。CollegeMsg和wiki-Vote在两种容差下均有损失。}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}参照集合改变时的传播量变化}{11}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces SNAP网络各次重复中全候选参照传播量的变化，高预算减低预算。（a）$W$从80增至320；（b）$W$从320增至1,280。各图内从左至右为重复编号1101--1105。实心圆表示最终集合改变，空心方块表示最终集合相同。误差线为根据10,000个配对评估世界计算的未经校正的95\%蒙特卡洛区间。两个面板的纵轴尺度不同。}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:transitions}{{3}{12}{SNAP网络各次重复中全候选参照传播量的变化，高预算减低预算。（a）$W$从80增至320；（b）$W$从320增至1,280。各图内从左至右为重复编号1101--1105。实心圆表示最终集合改变，空心方块表示最终集合相同。误差线为根据10,000个配对评估世界计算的未经校正的95\%蒙特卡洛区间。两个面板的纵轴尺度不同。}{figure.3}{}}
