\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces PageRank-4k on ca-GrQc at the default ($\tau =10^{-6}$) and strict ($\tau =10^{-12}$) tolerance. Gaps are restricted minus full-reference spread at the same $W$, in nodes, averaged over five replicates, with the standard deviation across replicates in parentheses. Changed sets counts the replicates on which the two tolerances select different final sets.}}{10}{table.3}\protected@file@percent }
\newlabel{tab:precision-output}{{3}{10}{PageRank-4k on ca-GrQc at the default ($\tau =10^{-6}$) and strict ($\tau =10^{-12}$) tolerance. Gaps are restricted minus full-reference spread at the same $W$, in nodes, averaged over five replicates, with the standard deviation across replicates in parentheses. Changed sets counts the replicates on which the two tolerances select different final sets}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Incremental-spread loss of PageRank pools relative to the full reference at the same $W$, at the default ($\tau =10^{-6}$) and strict ($\tau =10^{-12}$) tolerance. Top row: 4k pools; bottom row: 5\% pools. Points are means over five replicates and bars are standard deviations across replicates; a positive loss means that the restricted set reaches fewer vertices. On ca-GrQc, the default PageRank-4k loss changes sign across budgets, whereas the strict-tolerance loss stays below zero. On CollegeMsg and wiki-Vote, the losses persist at both tolerances.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:precision-budget}{{2}{10}{Incremental-spread loss of PageRank pools relative to the full reference at the same $W$, at the default ($\tau =10^{-6}$) and strict ($\tau =10^{-12}$) tolerance. Top row: 4k pools; bottom row: 5\% pools. Points are means over five replicates and bars are standard deviations across replicates; a positive loss means that the restricted set reaches fewer vertices. On ca-GrQc, the default PageRank-4k loss changes sign across budgets, whereas the strict-tolerance loss stays below zero. On CollegeMsg and wiki-Vote, the losses persist at both tolerances}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Change in full-reference spread between two selection budgets (higher minus lower $W$) for each replicate on the SNAP networks: (a) $W=80$ to 320; (b) $W=320$ to 1,280. Replicates 1101--1105 run from left to right within each graph. Filled circles mark replicates whose final set changed, and hollow squares mark unchanged sets. Bars are unadjusted 95\% Monte Carlo intervals from 10,000 paired evaluation worlds. Vertical scales differ between panels.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:transitions}{{3}{11}{Change in full-reference spread between two selection budgets (higher minus lower $W$) for each replicate on the SNAP networks: (a) $W=80$ to 320; (b) $W=320$ to 1,280. Replicates 1101--1105 run from left to right within each graph. Filled circles mark replicates whose final set changed, and hollow squares mark unchanged sets. Bars are unadjusted 95\% Monte Carlo intervals from 10,000 paired evaluation worlds. Vertical scales differ between panels}{figure.3}{}}
