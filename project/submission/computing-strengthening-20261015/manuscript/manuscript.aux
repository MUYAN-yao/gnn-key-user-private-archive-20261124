\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Primary candidate-minus-full spread differences at $W=5120$, $k=5$, $p=0.01$, $h=3$ under step coupling. Points are means of ten path-level differences; horizontal segments are 95\% percentile bootstrap intervals using 10,000 path resamples. Random $4k$ averages three pools within each path. All six candidate types are shown. Horizontal scales differ by network to retain small effects. Zero denotes the full reference, not an equivalence boundary}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:effects}{{2}{11}{Primary candidate-minus-full spread differences at $W=5120$, $k=5$, $p=0.01$, $h=3$ under step coupling. Points are means of ten path-level differences; horizontal segments are 95\% percentile bootstrap intervals using 10,000 path resamples. Random $4k$ averages three pools within each path. All six candidate types are shown. Horizontal scales differ by network to retain small effects. Zero denotes the full reference, not an equivalence boundary}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cost and descriptive tolerance for the prespecified weighted $4k$ diagnostic at $W=5120$. (a) Every one of ten paths per real network is shown; the horizontal axis is selection-only time saving, and the vertical axis is loss relative to full incremental spread. Negative loss denotes a higher candidate estimate. (b) Fraction of paths whose point estimate meets each illustrative tolerance. These are fixed-grid descriptions with a point-estimate denominator, not inferential preservation decisions. All other candidate types remain in the source tables}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:tradeoff}{{3}{12}{Cost and descriptive tolerance for the prespecified weighted $4k$ diagnostic at $W=5120$. (a) Every one of ten paths per real network is shown; the horizontal axis is selection-only time saving, and the vertical axis is loss relative to full incremental spread. Negative loss denotes a higher candidate estimate. (b) Fraction of paths whose point estimate meets each illustrative tolerance. These are fixed-grid descriptions with a point-estimate denominator, not inferential preservation decisions. All other candidate types remain in the source tables}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Mean weighted $4k$ minus full spread differences. First two columns vary transmission probability at $W=320,h=3$; last two compare couplings at $W=1280,p=0.01,h=3$. Ten paths per cell.}}{13}{table.5}\protected@file@percent }
\newlabel{tab:sensitivity}{{5}{13}{Mean weighted $4k$ minus full spread differences. First two columns vary transmission probability at $W=320,h=3$; last two compare couplings at $W=1280,p=0.01,h=3$. Ten paths per cell}{table.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Repeated timing}{13}{subsection.5.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Predefined sensitivity panels. (a) Weighted $4k$ mean incremental loss across ten paths at $W=320$ for all five $(p,h)$ settings, including the primary setting. (b) The same candidate type under step and fixed-edge coupling at $W=1280$. (c) All six candidate types on two explicitly synthetic 2,000-node instances at $W=320$, five paths each; W/D/PR/R denote weighted degree, degree, PageRank and random. Lines connect tested settings without implying interpolation. These panels are descriptive means; all path values and uncertainty summaries are supplied as source data}}{14}{figure.4}\protected@file@percent }
\newlabel{fig:sensitivity}{{4}{14}{Predefined sensitivity panels. (a) Weighted $4k$ mean incremental loss across ten paths at $W=320$ for all five $(p,h)$ settings, including the primary setting. (b) The same candidate type under step and fixed-edge coupling at $W=1280$. (c) All six candidate types on two explicitly synthetic 2,000-node instances at $W=320$, five paths each; W/D/PR/R denote weighted degree, degree, PageRank and random. Lines connect tested settings without implying interpolation. These panels are descriptive means; all path values and uncertainty summaries are supplied as source data}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Repeated timing at $k=5,W=320$, path 1001, $p=0.01,h=3$, step coupling. Bars stack the median selection and evaluation times over five additional randomized serial repetitions; dots show each repetition's total of those phases. Full and all eight restricted executions are retained. W2/W4/W8 denote weighted pools; D4 and PR4 denote topology-degree and PageRank; R0--R2 are separate random pools. Shared preprocessing and JIT compilation are excluded from this figure and reported separately}}{15}{figure.5}\protected@file@percent }
\newlabel{fig:timing}{{5}{15}{Repeated timing at $k=5,W=320$, path 1001, $p=0.01,h=3$, step coupling. Bars stack the median selection and evaluation times over five additional randomized serial repetitions; dots show each repetition's total of those phases. Full and all eight restricted executions are retained. W2/W4/W8 denote weighted pools; D4 and PR4 denote topology-degree and PageRank; R0--R2 are separate random pools. Shared preprocessing and JIT compilation are excluded from this figure and reported separately}{figure.5}{}}
