\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Frozen main-matrix incremental loss relative to each budget's full reference; PageRank uses default tolerance. Points are means of five computational paths; bars are path standard deviations. Random-pool repeats are averaged within each path first. Negative loss denotes independently measured gain against the finite reference. Graph panels retain a common percentage scale. Complete method summaries and source data accompany Online Resource 1}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:loss}{{2}{10}{Frozen main-matrix incremental loss relative to each budget's full reference; PageRank uses default tolerance. Points are means of five computational paths; bars are path standard deviations. Random-pool repeats are averaged within each path first. Negative loss denotes independently measured gain against the finite reference. Graph panels retain a common percentage scale. Complete method summaries and source data accompany Online Resource 1}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Post-hoc PageRank loss across budgets. Each entry is the mean incremental-loss percentage across five original paths at $W=80/320/1280$. Default uses NetworkX tolerance $10^{-6}$; strict uses $10^{-12}$, whose pool is unchanged at $10^{-14}$. Pool Jaccard compares default and strict candidates. This is a numerical sensitivity analysis, not a new primary test family.}}{11}{table.3}\protected@file@percent }
\newlabel{tab:precision-budget}{{3}{11}{Post-hoc PageRank loss across budgets. Each entry is the mean incremental-loss percentage across five original paths at $W=80/320/1280$. Default uses NetworkX tolerance $10^{-6}$; strict uses $10^{-12}$, whose pool is unchanged at $10^{-14}$. Pool Jaccard compares default and strict candidates. This is a numerical sensitivity analysis, not a new primary test family}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Post-hoc PageRank budget--precision sensitivity. Each point is the mean incremental loss over the original five paths; bars are path standard deviations. Default and strict refer to tolerances $10^{-6}$ and $10^{-12}$; strict pools agree at $10^{-14}$. Negative loss favors the restricted set. The panels show why the ca-GrQc default direction reversal cannot be generalized to the strict ranking, while CollegeMsg and wiki-Vote retain their named patterns. This is a diagnostic comparison, not a new primary test family.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:precision-budget}{{3}{11}{Post-hoc PageRank budget--precision sensitivity. Each point is the mean incremental loss over the original five paths; bars are path standard deviations. Default and strict refer to tolerances $10^{-6}$ and $10^{-12}$; strict pools agree at $10^{-14}$. Negative loss favors the restricted set. The panels show why the ca-GrQc default direction reversal cannot be generalized to the strict ranking, while CollegeMsg and wiki-Vote retain their named patterns. This is a diagnostic comparison, not a new primary test family}{figure.3}{}}
